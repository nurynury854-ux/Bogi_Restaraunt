// Multi-tenant ordering platform — Prisma schema (PostgreSQL)
// Status/method-style fields are plain Strings; allowed values are enforced in
// the app layer (Zod + TS union types) to keep the model simple and portable.
//
// Tenant isolation: every tenant-scoped table carries its own `tenantId`
// directly (not just via a parent relation), so queries can filter by it at
// the top level instead of relying on a join chain to prove ownership.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id           String    @id @default(cuid())
  slug         String    @unique
  businessName String
  logoUrl      String?
  accentColor  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  adminUsers   AdminUser[]
  branches     Branch[]
  categories   MenuCategory[]
  items        MenuItem[]
  timeSlots    TimeSlot[]
  orders       Order[]
}

model AdminUser {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Branch {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String
  phone     String
  hours     String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  timeSlots TimeSlot[]
  orders    Order[]

  @@unique([tenantId, name])
}

model MenuCategory {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     MenuItem[]

  @@unique([tenantId, name])
}

model MenuItem {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  price       Int
  description String?
  imageUrl    String?
  isAvailable Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orderItems  OrderItem[]
}

/// method: "PICKUP" | "DELIVERY"
model TimeSlot {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  method    String
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
}

/// diningMethod: "DINE_IN" | "PICKUP" | "DELIVERY"
/// status: "PENDING" | "COMPLETED" | "CANCELLED"
/// paymentMethod: "CASH" | "TRANSFER"
model Order {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNo         String
  branchId        String
  branch          Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  diningMethod    String
  status          String      @default("PENDING")
  tableNumber     String?
  timeSlotId      String?
  timeSlot        TimeSlot?   @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String
  deliveryAddress String?
  notes           String?
  paymentMethod   String
  totalAmount     Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]

  @@unique([tenantId, orderNo])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([createdAt])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String?
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  nameSnapshot  String
  priceSnapshot Int
  quantity      Int
  subtotal      Int
}
